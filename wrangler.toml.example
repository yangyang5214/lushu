# 复制为 wrangler.toml 后填入你自己的 D1 database_id（wrangler.toml 已 gitignore，不会提交）：
#   cp wrangler.toml.example wrangler.toml
#
# 先建库（不需要 wrangler.toml）：
#   pnpm wrangler login
#   pnpm wrangler d1 create lushu
name = "lushu"
compatibility_date = "2025-08-01"
pages_build_output_dir = "dist"

# database_id 不是密钥（账号内标识，没凭证访问不了），但仍各自用自己的库，避免误绑别人的。
[[d1_databases]]
binding = "DB"
database_name = "lushu"
database_id = "YOUR_DATABASE_ID_HERE"

[vars]
# 全局路书名额上限；0 表示不限。软上限，防止公开端点被刷满 D1 的 5 GB。
MAX_BOOKS = "20000"
# 单本路书 JSON 上限（字节）。300 个地点约 33 KB。
MAX_DOC_BYTES = "262144"

# 不要在这里放任何密钥。Turnstile secret 部署时用 pnpm secret:turnstile。
